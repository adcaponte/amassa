# Nenhum valor real neste arquivo. Copie para .env.local (dev) ou .env (servidor) e
# preencha lá — ambos ficam fora do controle de versão (ver .gitignore).

# Precisa existir também no momento do build (build-arg) — ver 01-ARQUITETURA.md §6
NEXT_PUBLIC_SITE_URL=

# Imagem publicada no GHCR, usada pelo compose do servidor
IMAGEM_APP=
IMAGEM_FERRAMENTAS=

# Banco — serviço postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Aplicação — serviço app (runtime, nunca embutido na imagem). DATABASE_URL usa o papel
# amassa_app; DATABASE_URL_MIGRACAO usa o dono do banco (amassa_owner) e roda as migrações —
# só o serviço ferramentas a lê (ver docker/compose.yml).
DATABASE_URL=
DATABASE_URL_MIGRACAO=
DATABASE_URL_TESTE=
AUTH_SECRET=
AUTH_TRUST_HOST=
TZ=

# Backup — usado pelo cron do host (Fase 2). BACKUP_DIR é o diretório onde os
# dumps diários ficam guardados no servidor (padrão em scripts/backup.sh: /opt/amassa/backups)
# — só precisa de valor aqui se você quiser um caminho diferente do padrão.
RCLONE_REMOTE=
BACKUP_DIR=
